# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Postgres (development):
DATABASE_URL="postgresql://localhost:5432/agentic_chat_dev"
# Neon (production) — copy the pooled connection string from the Neon console:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# RAG service (services/rag)
# ---------------------------------------------------------------------------
# Document ingestion and retrieval run in the FastAPI service. Embeddings,
# chunking and reranking are configured *there*, in services/rag/.env — not
# here. This app only needs to know where it is and how to authenticate.
RAG_SERVICE_URL="http://localhost:8000"
# Shared secret. Must match SERVICE_TOKEN in services/rag/.env.
# Generate one with: openssl rand -hex 32
RAG_SERVICE_TOKEN=""

# ---------------------------------------------------------------------------
# Rate limiting (per user)
# ---------------------------------------------------------------------------
# All off when unset or 0, so a single-user deployment is unaffected.
# Counted in memory per instance: on a multi-instance deploy the effective
# limit is instances x the value below.
#
# Concurrent chat streams. Each one holds a database connection from a pool of
# 10, so this is the limit that actually protects a shared deployment.
# RATE_LIMIT_CHAT_CONCURRENT="3"
# RATE_LIMIT_CHAT_PER_MINUTE="30"
# RATE_LIMIT_MODELS_PER_MINUTE="20"
# RATE_LIMIT_PACK_INSTALL_PER_MINUTE="10"
