# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The same Postgres the Next.js app uses. Drizzle owns the schema; this service
# only reads and writes rows, and never runs DDL.
DATABASE_URL="postgresql://localhost:5432/agentic_chat_dev"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Shared secret with the Next.js app. Must match RAG_SERVICE_TOKEN there.
# The service refuses every request while this is unset — an open endpoint that
# reads and writes any user's documents is not a safe default.
# Generate one with: openssl rand -hex 32
SERVICE_TOKEN=""

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Any endpoint speaking the OpenAI /embeddings shape:
#   OpenAI:  https://api.openai.com/v1    + text-embedding-3-small  (1536)
#   Voyage:  https://api.voyageai.com/v1  + voyage-3-lite           (1536)
#   Ollama:  http://localhost:11434/v1    + nomic-embed-text         (768!)
#
# The model MUST output 1536 dimensions — that width is baked into the
# `vector(1536)` column by Drizzle migration 0003. A different model means a new
# migration plus re-indexing every document.
EMBEDDINGS_BASE_URL="https://api.openai.com/v1"
EMBEDDINGS_MODEL="text-embedding-3-small"
# Optional. When unset, embedding is billed to the end user's own model key,
# which the Next.js app forwards with each request.
EMBEDDINGS_API_KEY=""

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
# Measured in real tokens (tiktoken), not characters.
# CHUNK_TOKENS="300"
# CHUNK_OVERLAP_TOKENS="45"

# ---------------------------------------------------------------------------
# Reranking
# ---------------------------------------------------------------------------
# A cross-encoder scores (query, chunk) pairs jointly instead of comparing
# pre-computed vectors — the single largest accuracy gain available here.
# Needs the 'rerank' extra installed (pulls in torch, ~2 GB).
# Leave unset and results come back in fusion order.
#   Fast, small:  cross-encoder/ms-marco-MiniLM-L-6-v2
#   Stronger:     BAAI/bge-reranker-v2-m3
# RERANK_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
# Candidates fetched per retriever before fusion and reranking.
# CANDIDATES_PER_RETRIEVER="30"
